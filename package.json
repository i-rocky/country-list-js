{
  "name": "country-list-js",
  "version": "3.1.3",
  "description": "Country list with ISO2, ISO3 code, continent, capital, dialing code",
  "homepage": "https://github.com/i-rocky/country-list-js.git",
  "author": {
    "name": "Rocky",
    "url": "https://github.com/users/i-rocky",
    "email": "wpkpda@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-rocky/country-list-js.git"
  },
  "bugs": {
    "url": "https://github.com/i-rocky/country-list-js/issues"
  },
  "license": "MIT",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/i-rocky/country-list-js/blob/master/LICENSE"
    }
  ],
  "main": "index.js",
  "module": "dist/index.mjs",
  "types": "index.d.ts",
  "unpkg": "dist/country.min.js",
  "jsdelivr": "dist/country.min.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./index.js": "./index.js",
    "./index": "./index.js",
    "./data/*.json": "./data/*.json",
    "./data/*": "./data/*.json",
    "./dist/*": "./dist/*",
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "data/",
    "dist/",
    "schema/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "country",
    "geopolitical",
    "iso2",
    "iso3",
    "phone",
    "continent",
    "capital",
    "region"
  ],
  "scripts": {
    "build:data": "node scripts/build.js",
    "build:types": "tsc",
    "build:bundle": "node scripts/bundle.js",
    "build": "npm run build:data && npm run build:types && npm run build:bundle",
    "validate": "node scripts/validate.js",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "eslint . && npm run validate && mocha t/*.js",
    "verify:package": "node scripts/verify-package.js"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "chai": "^4.0.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.32.0",
    "mocha": "^10.2.0",
    "typescript": "^5.9.3"
  }
}
