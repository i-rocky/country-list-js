{
  "name": "country-list-js",
  "version": "4.0.0-rc.1",
  "description": "Country data for 250 countries and territories: ISO 3166-1 codes, names, capitals, currencies, dialing codes, subdivisions, borders and IANA time zones. No dependencies.",
  "homepage": "https://i-rocky.github.io/country-list-js",
  "author": {
    "name": "Rocky",
    "url": "https://github.com/users/i-rocky",
    "email": "wpkpda@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-rocky/country-list-js.git"
  },
  "bugs": {
    "url": "https://github.com/i-rocky/country-list-js/issues"
  },
  "license": "MIT",
  "main": "index.js",
  "module": "dist/index.mjs",
  "types": "index.d.ts",
  "unpkg": "dist/country.min.js",
  "jsdelivr": "dist/country.min.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./index.js": "./index.js",
    "./index": "./index.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "data/",
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "country",
    "countries",
    "iso3166",
    "iso-3166",
    "iso2",
    "iso3",
    "country-codes",
    "capital",
    "currency",
    "iso4217",
    "dialing-code",
    "calling-code",
    "phone",
    "continent",
    "region",
    "province",
    "state",
    "subdivision",
    "timezone",
    "borders",
    "geography"
  ],
  "scripts": {
    "build": "npm run build:data && npm run build:types && npm run build:bundles",
    "build:data": "node scripts/build-data.js",
    "build:types": "tsc",
    "build:bundles": "node scripts/build-bundles.js",
    "site": "node scripts/build-site.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-data.js",
    "test:unit": "mocha test/*.js",
    "test": "npm run lint && npm run typecheck && npm run validate && npm run test:unit",
    "verify": "node scripts/verify-package.js",
    "prepare": "npm run build",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "chai": "^6.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "mocha": "^12.0.0",
    "typescript": "^7.0.2"
  }
}
